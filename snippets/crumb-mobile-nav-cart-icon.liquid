{%- doc -%}
  Cart icon with Horizon's live count bubble, used by the Crumb mobile nav.
  Reuses <cart-icon> so the count updates when items are added.
{%- enddoc -%}

<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

<cart-icon class="crumb-mobile-nav__cart">
  <span class="svg-wrapper" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  </span>
  {% render 'cart-bubble', limit: 100 %}
</cart-icon>