{%- doc -%}
  Crumb newsletter form. Used by the Join The Crumb Club panel and the footer,
  so the form exists once.

  Subscribes through Shopify's customer form with the "newsletter" tag.
  No custom submit handler.

  @param {string} form_id - Unique per form on the page. Also sets the #anchor the page lands on after the redirect.
  @param {string} [variant] - 'panel' (default) or 'footer'
  @param {string} [label] - Screen-reader label. Blank uses the theme's email label.
  @param {string} [placeholder] - Blank = no placeholder
  @param {string} [button_label] - Desktop label. Blank uses "Sign up".
  @param {string} [button_label_short] - Mobile label. Blank uses the desktop label.
  @param {boolean} [show_arrow] - Arrow icon inside the button
  @param {string} [success_message] - Blank uses the theme's default success text
  @param {string} [error_message] - Blank uses Shopify's own error text
{%- enddoc -%}

{%- liquid
  assign form_variant = variant | default: 'panel'

  assign field_id = form_id | append: '-email'
  assign status_id = form_id | append: '-status'

  assign field_label = label | strip
  if field_label == blank
    assign field_label = 'blocks.email_signup.label' | t
  endif

  assign placeholder_text = placeholder | strip

  assign btn_long = button_label | strip
  assign btn_short = button_label_short | strip
  if btn_long == blank
    assign btn_long = btn_short
  endif
  if btn_long == blank
    assign btn_long = 'actions.sign_up' | t
  endif

  assign success_text = success_message | strip
  if success_text == blank
    assign success_text = 'blocks.email_signup.success' | t
  endif

  assign custom_error = error_message | strip
-%}

<div class="crumb-newsletter crumb-newsletter--{{ form_variant }}" data-crumb-newsletter>
  {%- form 'customer', id: form_id, class: 'crumb-newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">

    <div class="crumb-newsletter__row">
      <label class="crumb-newsletter__sr" for="{{ field_id }}">{{ field_label | escape }}</label>

      <input
        id="{{ field_id }}"
        class="crumb-newsletter__input"
        type="email"
        name="contact[email]"
        autocomplete="email"
        autocapitalize="off"
        autocorrect="off"
        required
        {% if placeholder_text != blank %}placeholder="{{ placeholder_text | escape }}"{% endif %}
        {% if form.errors %}aria-invalid="true" aria-describedby="{{ status_id }}"{% endif %}
      >

      <button type="submit" class="crumb-newsletter__button">
        {%- if btn_short != blank and btn_short != btn_long -%}
          <span class="crumb-newsletter__long">{{ btn_long | escape }}</span>
          <span class="crumb-newsletter__short">{{ btn_short | escape }}</span>
        {%- else -%}
          <span>{{ btn_long | escape }}</span>
        {%- endif -%}
        {%- if show_arrow -%}
          <svg class="crumb-newsletter__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        {%- endif -%}
      </button>
    </div>

    {%- comment -%}
      Always in the DOM so it works as a live region. Kept free of whitespace
      so :empty hides it when there is nothing to say.
    {%- endcomment -%}
    <div class="crumb-newsletter__status" id="{{ status_id }}" role="status">
      {%- if form.errors -%}
        <p class="crumb-newsletter__message crumb-newsletter__message--error" data-crumb-newsletter-message>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
          </svg>
          <span>
            <span class="crumb-newsletter__prefix">Error:</span>
            {% if custom_error != blank -%}
              {{ custom_error | escape }}
            {%- else -%}
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            {%- endif %}
          </span>
        </p>
      {%- elsif form.posted_successfully? -%}
        <p class="crumb-newsletter__message crumb-newsletter__message--success" data-crumb-newsletter-message>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm-1.2 14.4L6.6 12.2l1.4-1.4 2.8 2.8 5.2-5.2 1.4 1.4z"/>
          </svg>
          <span>{{ success_text | escape | newline_to_br }}</span>
        </p>
      {%- endif -%}
    </div>
  {%- endform -%}
</div>

{% stylesheet %}
  .crumb-newsletter {
    /* The row switches between stacked and inline by the form's own width, not the viewport */
    container-type: inline-size;
    inline-size: 100%;
    font-family: var(--crumb-font-body);
    color: var(--crumb-ink);
  }

  .crumb-newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }

  .crumb-newsletter__row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* After a successful signup the message replaces the field */
  .crumb-newsletter:has(.crumb-newsletter__message--success) .crumb-newsletter__row {
    display: none;
  }

  .crumb-newsletter__sr {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .crumb-newsletter__input {
    box-sizing: border-box;
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: 2.75rem;
    padding: 0.625rem 0.875rem;
    /* 16px minimum stops iOS zooming the page when the field is focused */
    font: inherit;
    font-size: max(16px, 1rem);
    color: var(--crumb-ink);
    background: var(--crumb-surface-lowest);
    border: var(--crumb-border);
    border-radius: var(--crumb-radius-lg);
    box-shadow: var(--crumb-shadow-sm);
  }

  .crumb-newsletter__input::placeholder { color: var(--crumb-ink-muted); opacity: 1; }

  .crumb-newsletter__input:focus-visible,
  .crumb-newsletter__button:focus-visible {
    outline: 3px solid var(--crumb-primary);
    outline-offset: 2px;
  }

  .crumb-newsletter__button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0.625rem 1.5rem;
    font: inherit;
    font-size: max(16px, 1rem);
    font-weight: 800;
    white-space: nowrap;
    color: var(--crumb-on-coral);
    background: var(--crumb-coral);
    border: var(--crumb-border);
    border-radius: var(--crumb-radius-lg);
    box-shadow: var(--crumb-shadow-md);
    cursor: pointer;
    transition: box-shadow var(--crumb-transition), transform var(--crumb-transition);
  }

  .crumb-newsletter__button:hover { box-shadow: var(--crumb-shadow-lg); }

  .crumb-newsletter__button:active {
    box-shadow: var(--crumb-shadow-none);
    transform: translate(2px, 2px);
  }

  .crumb-newsletter__arrow {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Long / short button labels */
  .crumb-newsletter__short { display: none; }

  @media (max-width: 749px) {
    .crumb-newsletter__long { display: none; }
    .crumb-newsletter__short { display: inline; }
  }

  /* Footer variant: compact, always a single row when it fits */
  .crumb-newsletter--footer .crumb-newsletter__input {
    background: var(--crumb-surface);
    border-radius: var(--crumb-radius-md);
    box-shadow: none;
  }

  .crumb-newsletter--footer .crumb-newsletter__button {
    padding-inline: 1rem;
    border-radius: var(--crumb-radius-md);
    box-shadow: var(--crumb-shadow-sm);
  }

  /* Inline field + button once the form is wide enough */
  @container (min-width: 28rem) {
    .crumb-newsletter--panel .crumb-newsletter__row { flex-direction: row; align-items: stretch; }
    .crumb-newsletter--panel .crumb-newsletter__input { flex: 1 1 auto; }
    .crumb-newsletter--panel .crumb-newsletter__button { flex: 0 0 auto; }
  }

  @container (min-width: 18rem) {
    .crumb-newsletter--footer .crumb-newsletter__row { flex-direction: row; align-items: stretch; }
    .crumb-newsletter--footer .crumb-newsletter__input { flex: 1 1 auto; }
    .crumb-newsletter--footer .crumb-newsletter__button { flex: 0 0 auto; }
  }

  /* Messages: white box, ink text, icon and a dashed border for errors, so
     meaning never depends on color alone. Readable on both yellow and white. */
  .crumb-newsletter__message {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    text-align: start;
    color: var(--crumb-ink);
    background: var(--crumb-surface-lowest);
    border: var(--crumb-border);
    border-radius: var(--crumb-radius-md);
    box-shadow: var(--crumb-shadow-sm);
  }

  .crumb-newsletter__message svg { flex-shrink: 0; fill: currentColor; }
  .crumb-newsletter__message--success svg { color: var(--crumb-mint-deep); }
  .crumb-newsletter__message--error { border-style: dashed; }
  .crumb-newsletter__message--error svg { color: var(--crumb-primary); }
  .crumb-newsletter__prefix { font-weight: 800; }

  .crumb-newsletter__status:empty { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .crumb-newsletter__button { transition: none; }
    .crumb-newsletter__button:active { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  /*
    Guard for pages with two newsletter forms. If Shopify reports the posted
    state on both, keep the message only on the form named in the URL hash.
    If Shopify already scopes it correctly, this changes nothing.
  */
  (() => {
    const run = () => {
      const wrappers = document.querySelectorAll('[data-crumb-newsletter]');
      if (wrappers.length < 2) return;

      let id = '';
      try { id = decodeURIComponent(window.location.hash.slice(1)); } catch (error) { return; }
      if (!id) return;

      const owner = document.getElementById(id);
      if (!owner || !owner.closest('[data-crumb-newsletter]')) return;

      wrappers.forEach((wrapper) => {
        if (wrapper.contains(owner)) return;
        wrapper.querySelectorAll('[data-crumb-newsletter-message]').forEach((message) => message.remove());
        wrapper.querySelectorAll('input[aria-invalid]').forEach((input) => {
          input.removeAttribute('aria-invalid');
          input.removeAttribute('aria-describedby');
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true });
    } else {
      run();
    }
  })();
{% endjavascript %}