{%- comment -%}
  crumb-steps: "Build Happiness in 3 Steps"

  - Header: tag chip + h2 heading (left), optional subtext (right on desktop).
    Each part is skipped when its setting is blank.
  - Cards: one block per card. Design range is 2 to 4 (max_blocks: 4).
    The number comes from loop position unless the block's number setting is filled.
  - Colors come from the Crumb color settings through the aliases below.
  - The number and both icons are decorative (aria-hidden).
{%- endcomment -%}

{%- liquid
  assign tag_text = section.settings.tag
  assign heading_text = section.settings.heading
  assign subtext = section.settings.subtext
  assign column_count = section.blocks.size | at_most: 4 | at_least: 1
-%}

<div
  class="crumb-steps"
  style="
    --steps-columns: {{ column_count }};
    --steps-padding-top: {{ section.settings.padding_top }}px;
    --steps-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="crumb-steps__inner">
    {%- if tag_text != blank or heading_text != blank or subtext != blank -%}
      <header class="crumb-steps__header">
        <div class="crumb-steps__intro">
          {%- if tag_text != blank -%}
            <span class="crumb-steps__tag">{{ tag_text }}</span>
          {%- endif -%}
          {%- if heading_text != blank -%}
            <h2 class="crumb-steps__heading">{{ heading_text }}</h2>
          {%- endif -%}
        </div>

        {%- if subtext != blank -%}
          <p class="crumb-steps__subtext">{{ subtext }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="crumb-steps__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign step_number = block.settings.number | default: forloop.index
            assign step_color = block.settings.color | default: 'coral'
            assign footer_text = block.settings.footer_text
            assign footer_icon = block.settings.footer_icon
          -%}

          <li
            class="crumb-steps__card crumb-steps__card--{{ step_color }}"
            {{ block.shopify_attributes }}
          >
            <div class="crumb-steps__top">
              <span class="crumb-steps__number" aria-hidden="true">{{ step_number }}</span>
              <span class="crumb-steps__icon" aria-hidden="true">
                {%- render 'crumb-hero-icon', name: block.settings.icon -%}
              </span>
            </div>

            <div class="crumb-steps__body">
              {%- if block.settings.title != blank -%}
                <h3 class="crumb-steps__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="crumb-steps__description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>

            {%- if footer_text != blank -%}
              <p class="crumb-steps__footer">
                {%- if footer_icon != 'none' -%}
                  <span class="crumb-steps__footer-icon" aria-hidden="true">
                    {%- render 'crumb-hero-icon', name: footer_icon -%}
                  </span>
                {%- endif -%}
                <span>{{ footer_text }}</span>
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .crumb-steps {
    /* Token aliases. If your variable names differ, change only these lines. */
    --steps-ink: var(--crumb-ink);
    --steps-surface: var(--crumb-surface);
    --steps-muted: var(--crumb-ink-muted);
    --steps-divider: var(--crumb-divider);
    --steps-coral: var(--crumb-coral);
    --steps-teal: var(--crumb-teal);
    --steps-mustard: var(--crumb-mustard);
    --steps-on-coral: var(--crumb-on-coral);
    --steps-on-teal: var(--crumb-on-teal);
    --steps-on-mustard: var(--crumb-on-mustard);

    --steps-border: 2px solid var(--steps-ink);
    --steps-shadow: 4px 4px 0 var(--steps-ink);
    --steps-shadow-hover: 6px 6px 0 var(--steps-ink);
    --steps-radius: var(--crumb-radius-lg, 0.75rem);

    padding-block: var(--steps-padding-top) var(--steps-padding-bottom);
    font-family: var(--crumb-font-body);
    color: var(--steps-ink);
  }

  /* Gutter is wider than the 6px hover shadow, so shadows never clip.
     Do not add overflow: hidden to this section or the grid. */
  .crumb-steps__inner {
    max-inline-size: var(--crumb-page-width, 80rem);
    margin-inline: auto;
    padding-inline: var(--crumb-gutter, 1rem);
  }

  /* Header */
  .crumb-steps__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }

  .crumb-steps__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .crumb-steps__tag {
    padding: 0.125rem 0.625rem;
    border: var(--steps-border);
    border-radius: 0.375rem;
    background: var(--steps-teal);
    color: var(--steps-on-teal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 var(--steps-ink);
    transform: rotate(1deg);
  }

  .crumb-steps__heading {
    margin: 0;
    font-family: var(--crumb-font-heading);
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .crumb-steps__subtext {
    margin: 0;
    max-inline-size: 28rem;
    color: var(--steps-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Grid: single column on mobile, equal-height cards (grid stretch) */
  .crumb-steps__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumb-steps__card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-inline-size: 0;
    padding: 1.25rem;
    border: var(--steps-border);
    border-radius: var(--steps-radius);
    background: var(--steps-surface);
    box-shadow: var(--steps-shadow);
  }

  .crumb-steps__card--coral {
    --step-bg: var(--steps-coral);
    --step-fg: var(--steps-on-coral);
  }

  .crumb-steps__card--teal {
    --step-bg: var(--steps-teal);
    --step-fg: var(--steps-on-teal);
  }

  .crumb-steps__card--mustard {
    --step-bg: var(--steps-mustard);
    --step-fg: var(--steps-on-mustard);
  }

  .crumb-steps__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .crumb-steps__number {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: var(--steps-border);
    border-radius: 0.75rem;
    background: var(--step-bg);
    color: var(--step-fg);
    font-family: var(--crumb-font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    box-shadow: 2px 2px 0 var(--steps-ink);
    transform: rotate(-3deg);
  }

  .crumb-steps__icon,
  .crumb-steps__footer-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--steps-muted);
  }

  .crumb-steps__icon svg {
    inline-size: 1.75rem;
    block-size: 1.75rem;
  }

  .crumb-steps__footer-icon svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .crumb-steps__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-inline-size: 0;
  }

  .crumb-steps__title {
    margin: 0;
    font-family: var(--crumb-font-heading);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  .crumb-steps__description {
    margin: 0;
    color: var(--steps-muted);
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  /* margin-top: auto pins the footer to the bottom, so cards stay equal height */
  .crumb-steps__footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: auto 0 0;
    padding-block-start: 0.75rem;
    border-block-start: 2px solid var(--steps-divider);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  /* Tablet: two columns. An odd last card spans the full row. */
  @media (min-width: 750px) {
    .crumb-steps__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-block-end: 2.5rem;
    }

    .crumb-steps__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .crumb-steps__card {
      padding: 1.5rem;
    }

    .crumb-steps__card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: one row, column count follows the number of blocks (1 to 4) */
  @media (min-width: 990px) {
    .crumb-steps__grid {
      grid-template-columns: repeat(var(--steps-columns), minmax(0, 1fr));
    }

    .crumb-steps__card:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .crumb-steps__card,
    .crumb-steps__number {
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .crumb-steps__card:hover {
      transform: translateY(-4px);
      box-shadow: var(--steps-shadow-hover);
    }

    .crumb-steps__card:hover .crumb-steps__number {
      transform: rotate(0deg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crumb steps",
  "tag": "section",
  "class": "crumb-steps-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag chip",
      "default": "Simple Custom Craving"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Happiness in 3 Steps"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "info": "Shown on the right on desktop. Leave empty to hide.",
      "default": "No surprise fillers or dusty mystery boxes. Every bite is picked by you, hand-sealed, and delivered on your schedule."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step card",
      "settings": [
        {
          "type": "select",
          "id": "color",
          "label": "Number color",
          "options": [
            { "value": "coral", "label": "Coral" },
            { "value": "teal", "label": "Teal" },
            { "value": "mustard", "label": "Mustard" }
          ],
          "default": "coral"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number (optional)",
          "info": "Leave blank to number automatically by card position."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "box", "label": "Box" },
            { "value": "basket", "label": "Basket" },
            { "value": "tag", "label": "Tag" },
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Check" }
          ],
          "default": "box"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pick Your Box Size"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Select Mini, Classic, or Party Feast based on your hunger level or gift budget."
        },
        {
          "type": "text",
          "id": "footer_text",
          "label": "Footer tag",
          "info": "Plain marketing copy. Leave empty to hide the footer.",
          "default": "From $18.00 USD"
        },
        {
          "type": "select",
          "id": "footer_icon",
          "label": "Footer icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Tag" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Crumb steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "color": "mustard",
            "icon": "box",
            "title": "Pick Your Box Size",
            "description": "Select Mini, Classic, or Party Feast based on your hunger level or gift budget.",
            "footer_text": "From $18.00 USD",
            "footer_icon": "check"
          }
        },
        {
          "type": "step",
          "settings": {
            "color": "teal",
            "icon": "basket",
            "title": "Fill Every Slot",
            "description": "Mix and match sweet chocolate drizzles, savory smoked crunch, and spicy chili tang without rules.",
            "footer_text": "16+ Rotating Recipes",
            "footer_icon": "check"
          }
        },
        {
          "type": "step",
          "settings": {
            "color": "coral",
            "icon": "tag",
            "title": "Snip & Save Bundle",
            "description": "Bigger boxes automatically unlock tier discounts, free greeting notes, and direct doorstep shipping.",
            "footer_text": "Zero Subscription Lock-in",
            "footer_icon": "check"
          }
        }
      ]
    }
  ]
}
{% endschema %}