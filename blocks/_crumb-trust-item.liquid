{%- liquid
  assign icon = block.settings.icon
-%}

<div class="crumb-hero__trust-item crumb-hero__trust-item--{{ icon }}" {{ block.shopify_attributes }}>
  {%- if icon == 'stars' -%}
    <span class="crumb-hero__trust-icon crumb-hero__trust-icon--wide" aria-hidden="true">
      {%- render 'crumb-hero-icon', name: 'stars' -%}
    </span>
    <span class="crumb-hero__trust-icon crumb-hero__trust-icon--single" aria-hidden="true">
      {%- render 'crumb-hero-icon', name: 'star' -%}
    </span>
  {%- else -%}
    <span class="crumb-hero__trust-icon" aria-hidden="true">
      {%- render 'crumb-hero-icon', name: icon -%}
    </span>
  {%- endif -%}
  <span>{{ block.settings.text }}</span>
</div>

{% schema %}
{
  "name": "Trust item",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "stars", "label": "Rating (5 stars on desktop, 1 on phone)" },
        { "value": "star", "label": "Star" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "truck", "label": "Truck" },
        { "value": "bolt", "label": "Bolt" },
        { "value": "check", "label": "Check" },
        { "value": "heart", "label": "Heart" }
      ],
      "default": "leaf"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Zero Preservatives"
    }
  ]
}
{% endschema %}